{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "auto",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/",
    "backlog/",
    "apps/",
    "docs/api/",
    "etc/temp/",
    "etc/codemods/",
    "third-party/",
    ".eser/recipes/",
    "node_modules/",
    "dist/",
    "pnpm-lock.yaml"
  ]
}
