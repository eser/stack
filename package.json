{
  "name": "@eserstack/stack",
  "version": "4.5.2",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26.9"
  },
  "type": "module",
  "workspaces": [
    "pkg/@eserstack/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "test": "node --test --test-force-exit \"pkg/**/*.test.ts\" \"etc/scripts/**/*.test.ts\"",
    "bench": "find pkg/@eserstack -name '*.bench.ts' -not -path '*/node_modules/*' -print0 | xargs -0 -n 1 node",
    "cli": "deno run --allow-all ./pkg/@eserstack/cli/main.ts",
    "laroux-cli": "deno run --allow-all ./pkg/@eserstack/laroux-server/cli.ts",
    "noskills-cli": "deno run --allow-all ./pkg/@eserstack/noskills/main.ts"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*",
    "@types/node": "^26.6.1",
    "mitata": "1.0.34",
    "oxc-parser": "0.155.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
