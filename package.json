{
  "name": "@eserstack/stack",
  "version": "4.5.2",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=26.9"
  },
  "type": "module",
  "workspaces": [
    "pkg/@eserstack/*"
  ],
  "scripts": {
    "cli": "deno run --allow-all ./pkg/@eserstack/cli/main.ts",
    "laroux-cli": "deno run --allow-all ./pkg/@eserstack/laroux-server/cli.ts",
    "noskills-cli": "deno run --allow-all ./pkg/@eserstack/noskills/main.ts"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*",
    "@types/node": "^26.6.1",
    "mitata": "1.0.34",
    "oxc-parser": "0.155.0"
  }
}
