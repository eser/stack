{
  "name": "@eserstack/ai",
  "version": "4.5.2",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./main.ts",
    "./mod": "./mod.ts",
    "./module": "./module.ts",
    "./adapters": "./adapters/mod.ts",
    "./streams": "./streams/mod.ts",
    "./commands/ask": "./commands/ask.ts",
    "./commands/list": "./commands/list.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      },
      "./mod": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./module": {
        "types": "./dist/module.d.ts",
        "import": "./dist/module.js"
      },
      "./adapters": {
        "types": "./dist/adapters/mod.d.ts",
        "import": "./dist/adapters/mod.js"
      },
      "./streams": {
        "types": "./dist/streams/mod.d.ts",
        "import": "./dist/streams/mod.js"
      },
      "./commands/ask": {
        "types": "./dist/commands/ask.d.ts",
        "import": "./dist/commands/ask.js"
      },
      "./commands/list": {
        "types": "./dist/commands/list.d.ts",
        "import": "./dist/commands/list.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@eserstack/ajan": "workspace:*",
    "@eserstack/httpclient": "workspace:*",
    "@eserstack/logging": "workspace:*",
    "@eserstack/primitives": "workspace:*",
    "@eserstack/shell": "workspace:*",
    "@eserstack/standards": "workspace:*",
    "@eserstack/streams": "workspace:*",
    "@google/genai": "^2.23.0",
    "openai": "^7.17.0"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
