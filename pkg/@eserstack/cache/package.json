{
  "name": "@eserstack/cache",
  "version": "4.5.2",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./xdg": "./xdg.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./xdg": {
        "types": "./dist/xdg.d.ts",
        "import": "./dist/xdg.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/standards": "workspace:*",
    "@eserstack/ajan": "workspace:*"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
