{
  "name": "@eserstack/codebase",
  "version": "5.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eser/stack",
    "directory": "pkg/@eserstack/codebase"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./mod": "./mod.ts",
    "./directive-analysis": "./directive-analysis.ts",
    "./git": "./git.ts",
    "./native-functions": "./native-functions.ts",
    "./package": "./package/mod.ts",
    "./workspace-discovery": "./workspace-discovery.ts",
    "./cli-support": "./cli-support.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./mod": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./directive-analysis": {
        "types": "./dist/directive-analysis.d.ts",
        "import": "./dist/directive-analysis.js"
      },
      "./git": {
        "types": "./dist/git.d.ts",
        "import": "./dist/git.js"
      },
      "./native-functions": {
        "types": "./dist/native-functions.d.ts",
        "import": "./dist/native-functions.js"
      },
      "./package": {
        "types": "./dist/package/mod.d.ts",
        "import": "./dist/package/mod.js"
      },
      "./workspace-discovery": {
        "types": "./dist/workspace-discovery.d.ts",
        "import": "./dist/workspace-discovery.js"
      },
      "./cli-support": {
        "types": "./dist/cli-support.d.ts",
        "import": "./dist/cli-support.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/ajan": "workspace:*",
    "@eserstack/config": "workspace:*",
    "@eserstack/fp": "workspace:*",
    "@eserstack/shell": "workspace:*",
    "@eserstack/standards": "workspace:*"
  },
  "devDependencies": {
    "@eserstack/functions": "workspace:*",
    "@eserstack/logging": "workspace:*",
    "@eserstack/primitives": "workspace:*",
    "@eserstack/test-kit": "workspace:*",
    "@eserstack/workflows": "workspace:*"
  }
}
