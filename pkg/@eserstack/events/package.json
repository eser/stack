{
  "name": "@eserstack/events",
  "version": "4.5.2",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./container": "./container.ts",
    "./events": "./events.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./container": {
        "types": "./dist/container.d.ts",
        "import": "./dist/container.js"
      },
      "./events": {
        "types": "./dist/events.d.ts",
        "import": "./dist/events.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
