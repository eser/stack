{
  "name": "@eserstack/httpclient",
  "version": "4.5.2",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./client": "./client.ts",
    "./errors": "./errors.ts",
    "./interceptors": "./interceptors.ts",
    "./types": "./types.ts",
    "./go-client": "./go-client.ts",
    "./h3-fetch": "./h3-fetch.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      },
      "./errors": {
        "types": "./dist/errors.d.ts",
        "import": "./dist/errors.js"
      },
      "./interceptors": {
        "types": "./dist/interceptors.d.ts",
        "import": "./dist/interceptors.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      },
      "./go-client": {
        "types": "./dist/go-client.d.ts",
        "import": "./dist/go-client.js"
      },
      "./h3-fetch": {
        "types": "./dist/h3-fetch.d.ts",
        "import": "./dist/h3-fetch.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/primitives": "workspace:*",
    "@eserstack/ajan": "workspace:*"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
