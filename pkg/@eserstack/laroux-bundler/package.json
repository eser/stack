{
  "name": "@eserstack/laroux-bundler",
  "version": "4.5.2",
  "description": "Framework-agnostic bundler for the laroux.js framework with hexagonal architecture",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./adapters": "./adapters/mod.ts",
    "./adapters/react": "./adapters/react/mod.ts",
    "./adapters/tailwindcss": "./adapters/tailwindcss/mod.ts",
    "./adapters/lightningcss": "./adapters/lightningcss/mod.ts",
    "./adapters/sharp": "./adapters/sharp/mod.ts",
    "./adapters/fonts": "./adapters/fonts/mod.ts",
    "./adapters/runtime-bundler": "./adapters/runtime-bundler/mod.ts",
    "./adapters/prebuilt-bundler": "./adapters/prebuilt-bundler/mod.ts",
    "./system": "./system.ts",
    "./config": "./config.ts",
    "./types": "./types.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./adapters": {
        "types": "./dist/adapters/mod.d.ts",
        "import": "./dist/adapters/mod.js"
      },
      "./adapters/react": {
        "types": "./dist/adapters/react/mod.d.ts",
        "import": "./dist/adapters/react/mod.js"
      },
      "./adapters/tailwindcss": {
        "types": "./dist/adapters/tailwindcss/mod.d.ts",
        "import": "./dist/adapters/tailwindcss/mod.js"
      },
      "./adapters/lightningcss": {
        "types": "./dist/adapters/lightningcss/mod.d.ts",
        "import": "./dist/adapters/lightningcss/mod.js"
      },
      "./adapters/sharp": {
        "types": "./dist/adapters/sharp/mod.d.ts",
        "import": "./dist/adapters/sharp/mod.js"
      },
      "./adapters/fonts": {
        "types": "./dist/adapters/fonts/mod.d.ts",
        "import": "./dist/adapters/fonts/mod.js"
      },
      "./adapters/runtime-bundler": {
        "types": "./dist/adapters/runtime-bundler/mod.d.ts",
        "import": "./dist/adapters/runtime-bundler/mod.js"
      },
      "./adapters/prebuilt-bundler": {
        "types": "./dist/adapters/prebuilt-bundler/mod.d.ts",
        "import": "./dist/adapters/prebuilt-bundler/mod.js"
      },
      "./system": {
        "types": "./dist/system.d.ts",
        "import": "./dist/system.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/bundler": "workspace:*",
    "@eserstack/codebase": "workspace:*",
    "@eserstack/collector": "workspace:*",
    "@eserstack/laroux": "workspace:*",
    "@eserstack/laroux-react": "workspace:*",
    "@eserstack/logging": "workspace:*",
    "@eserstack/standards": "workspace:*",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
