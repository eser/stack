{
  "name": "@eserstack/laroux-bundler",
  "version": "4.1.58",
  "description": "Framework-agnostic bundler for the laroux.js framework with hexagonal architecture",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./adapters": "./adapters/mod.ts",
    "./adapters/react": "./adapters/react/mod.ts",
    "./adapters/tailwindcss": "./adapters/tailwindcss/mod.ts",
    "./adapters/lightningcss": "./adapters/lightningcss/mod.ts",
    "./adapters/sharp": "./adapters/sharp/mod.ts",
    "./adapters/fonts": "./adapters/fonts/mod.ts",
    "./adapters/runtime-bundler": "./adapters/runtime-bundler/mod.ts",
    "./adapters/prebuilt-bundler": "./adapters/prebuilt-bundler/mod.ts",
    "./system": "./system.ts",
    "./config": "./config.ts",
    "./types": "./types.ts"
  },
  "dependencies": {
    "@eserstack/bundler": "workspace:*",
    "@eserstack/codebase": "workspace:*",
    "@eserstack/collector": "workspace:*",
    "@eserstack/laroux": "workspace:*",
    "@eserstack/laroux-react": "workspace:*",
    "@eserstack/logging": "workspace:*",
    "@eserstack/standards": "workspace:*",
    "@std/fs": "npm:@jsr/std__fs@^1.0.24",
    "@std/ulid": "npm:@jsr/std__ulid@^1.0.0",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@std/assert": "npm:@jsr/std__assert@^1.0.19"
  }
}
