{
  "name": "@eserstack/laroux-react",
  "version": "4.5.2",
  "description": "React adapter for the laroux.js framework",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "client.ts",
    "protocol.ts",
    "client/bootstrap/",
    "runtime/image/fallback.ts",
    "runtime/navigation/link-navigation.ts"
  ],
  "exports": {
    ".": "./mod.ts",
    "./client": "./client.ts",
    "./protocol": "./protocol.ts",
    "./client/bootstrap": "./client/bootstrap/index.ts",
    "./span-renderer": "./span-renderer.ts",
    "./use-function": "./use-function.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "import": "./dist/protocol.js"
      },
      "./client/bootstrap": "./client/bootstrap/index.ts",
      "./span-renderer": {
        "types": "./dist/span-renderer.d.ts",
        "import": "./dist/span-renderer.js"
      },
      "./use-function": {
        "types": "./dist/use-function.d.ts",
        "import": "./dist/use-function.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/functions": "workspace:*",
    "@eserstack/laroux": "workspace:*",
    "@eserstack/logging": "workspace:*",
    "@eserstack/primitives": "workspace:*",
    "@eserstack/streams": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
