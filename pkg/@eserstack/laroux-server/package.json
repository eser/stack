{
  "name": "@eserstack/laroux-server",
  "version": "4.5.2",
  "description": "Server runtime for the laroux.js framework",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./main.ts",
    "./config": "./config/load-config.ts",
    "./adapters/react": "./adapters/react/mod.ts",
    "./action-registry": "./domain/action-registry.ts",
    "./module": "./module.ts",
    "./cli": "./cli.ts",
    "./commands/init": "./commands/init.ts",
    "./commands/dev": "./commands/dev.ts",
    "./commands/build": "./commands/build.ts",
    "./commands/serve": "./commands/serve.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      },
      "./config": {
        "types": "./dist/config/load-config.d.ts",
        "import": "./dist/config/load-config.js"
      },
      "./adapters/react": {
        "types": "./dist/adapters/react/mod.d.ts",
        "import": "./dist/adapters/react/mod.js"
      },
      "./action-registry": {
        "types": "./dist/domain/action-registry.d.ts",
        "import": "./dist/domain/action-registry.js"
      },
      "./module": {
        "types": "./dist/module.d.ts",
        "import": "./dist/module.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "import": "./dist/cli.js"
      },
      "./commands/init": {
        "types": "./dist/commands/init.d.ts",
        "import": "./dist/commands/init.js"
      },
      "./commands/dev": {
        "types": "./dist/commands/dev.d.ts",
        "import": "./dist/commands/dev.js"
      },
      "./commands/build": {
        "types": "./dist/commands/build.d.ts",
        "import": "./dist/commands/build.js"
      },
      "./commands/serve": {
        "types": "./dist/commands/serve.d.ts",
        "import": "./dist/commands/serve.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/codebase": "workspace:*",
    "@eserstack/fp": "workspace:*",
    "@eserstack/functions": "workspace:*",
    "@eserstack/http": "workspace:*",
    "@eserstack/kit": "workspace:*",
    "@eserstack/laroux": "workspace:*",
    "@eserstack/laroux-bundler": "workspace:*",
    "@eserstack/laroux-react": "workspace:*",
    "@eserstack/logging": "workspace:*",
    "@eserstack/primitives": "workspace:*",
    "@eserstack/shell": "workspace:*",
    "@eserstack/standards": "workspace:*",
    "@eserstack/streams": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2"
  }
}
