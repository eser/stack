{
  "name": "@eserstack/laroux",
  "version": "4.5.2",
  "description": "Framework-agnostic core utilities for laroux.js",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./navigation": "./navigation/mod.ts",
    "./image": "./image/mod.ts",
    "./router": "./router/mod.ts",
    "./config": "./config/mod.ts",
    "./chunk-manifest": "./chunk-manifest/mod.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./navigation": {
        "types": "./dist/navigation/mod.d.ts",
        "import": "./dist/navigation/mod.js"
      },
      "./image": {
        "types": "./dist/image/mod.d.ts",
        "import": "./dist/image/mod.js"
      },
      "./router": {
        "types": "./dist/router/mod.d.ts",
        "import": "./dist/router/mod.js"
      },
      "./config": {
        "types": "./dist/config/mod.d.ts",
        "import": "./dist/config/mod.js"
      },
      "./chunk-manifest": {
        "types": "./dist/chunk-manifest/mod.d.ts",
        "import": "./dist/chunk-manifest/mod.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/standards": "workspace:*"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
