{
  "name": "@eserstack/noskills-client",
  "version": "4.5.2",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./types": "./types.ts",
    "./cert": "./cert.ts",
    "./client": "./client.ts",
    "./attach": "./attach.ts",
    "./errors": "./errors.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "import": "./dist/types.js"
      },
      "./cert": {
        "types": "./dist/cert.d.ts",
        "import": "./dist/cert.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      },
      "./attach": {
        "types": "./dist/attach.d.ts",
        "import": "./dist/attach.js"
      },
      "./errors": {
        "types": "./dist/errors.d.ts",
        "import": "./dist/errors.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/mux": "workspace:*",
    "@eserstack/webtransport": "workspace:*"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
