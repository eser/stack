{
  "name": "@eserstack/noskills",
  "version": "4.5.2",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./main.ts",
    "./mod": "./mod.ts",
    "./module": "./module.ts",
    "./dashboard": "./dashboard/mod.ts",
    "./persistence": "./state/persistence.ts",
    "./session": "./manager/session-binding.ts",
    "./go-noskills": "./go-noskills.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      },
      "./mod": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./module": {
        "types": "./dist/module.d.ts",
        "import": "./dist/module.js"
      },
      "./dashboard": {
        "types": "./dist/dashboard/mod.d.ts",
        "import": "./dist/dashboard/mod.js"
      },
      "./persistence": {
        "types": "./dist/state/persistence.d.ts",
        "import": "./dist/state/persistence.js"
      },
      "./session": {
        "types": "./dist/manager/session-binding.d.ts",
        "import": "./dist/manager/session-binding.js"
      },
      "./go-noskills": {
        "types": "./dist/go-noskills.d.ts",
        "import": "./dist/go-noskills.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/agents": "workspace:*",
    "@eserstack/ai": "workspace:*",
    "@eserstack/ajan": "workspace:*",
    "@eserstack/codebase": "workspace:*",
    "@eserstack/mux": "workspace:*",
    "@eserstack/primitives": "workspace:*",
    "@eserstack/shell": "workspace:*",
    "@eserstack/standards": "workspace:*",
    "@eserstack/streams": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*",
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "@eserstack/ajan-darwin-arm64": "workspace:*",
    "@eserstack/ajan-darwin-x64": "workspace:*",
    "@eserstack/ajan-linux-arm64": "workspace:*",
    "@eserstack/ajan-linux-x64": "workspace:*",
    "@eserstack/ajan-win32-x64": "workspace:*",
    "@eserstack/ajan-wasm": "workspace:*",
    "@eserstack/noskills-darwin-arm64": "workspace:*",
    "@eserstack/noskills-darwin-x64": "workspace:*",
    "@eserstack/noskills-linux-arm64": "workspace:*",
    "@eserstack/noskills-linux-x64": "workspace:*",
    "@eserstack/noskills-win32-x64": "workspace:*"
  }
}
