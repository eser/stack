# @eserstack/posts Configuration
# Put your API keys in .env.local (gitignored).

TWITTER_CLIENT_ID=
TWITTER_REDIRECT_URI=http://localhost:3000/callback
BLUESKY_IDENTIFIER=
AI_PROVIDER=anthropic
# TWITTER_API_BASE_URL, BLUESKY_PDS_HOST and POSTS_TOKEN_STORE_PATH are read
# from the process environment only, never from a .env file. The token store
# defaults to ~/.eser/posts/tokens.json.
