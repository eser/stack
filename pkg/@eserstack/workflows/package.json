{
  "name": "@eserstack/workflows",
  "version": "5.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eser/stack",
    "directory": "pkg/@eserstack/workflows"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./mod.ts",
    "./mod": "./mod.ts",
    "./loader": "./loader.ts",
    "./native-functions": "./native-functions.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./mod": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./loader": {
        "types": "./dist/loader.d.ts",
        "import": "./dist/loader.js"
      },
      "./native-functions": {
        "types": "./dist/native-functions.d.ts",
        "import": "./dist/native-functions.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/config": "workspace:*",
    "@eserstack/functions": "workspace:*",
    "@eserstack/primitives": "workspace:*",
    "@eserstack/shell": "workspace:*",
    "@eserstack/standards": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
