{
  "name": "@eserstack/workflows",
  "version": "4.5.2",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "exports": {
    ".": "./main.ts",
    "./mod": "./mod.ts",
    "./module": "./module.ts",
    "./loader": "./loader.ts",
    "./run": "./run.ts",
    "./list": "./list.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "import": "./dist/main.js"
      },
      "./mod": {
        "types": "./dist/mod.d.ts",
        "import": "./dist/mod.js"
      },
      "./module": {
        "types": "./dist/module.d.ts",
        "import": "./dist/module.js"
      },
      "./loader": {
        "types": "./dist/loader.d.ts",
        "import": "./dist/loader.js"
      },
      "./run": {
        "types": "./dist/run.d.ts",
        "import": "./dist/run.js"
      },
      "./list": {
        "types": "./dist/list.d.ts",
        "import": "./dist/list.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../../etc/scripts/build-library.ts"
  },
  "dependencies": {
    "@eserstack/config": "workspace:*",
    "@eserstack/functions": "workspace:*",
    "@eserstack/primitives": "workspace:*",
    "@eserstack/shell": "workspace:*",
    "@eserstack/standards": "workspace:*",
    "@eserstack/streams": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eserstack/test-kit": "workspace:*"
  }
}
