{
  "provider": "openai",
  "scenario": "error_request_timeout",
  "exchanges": [
    {
      "request": {
        "headers": {
          "accept": "application/json",
          "accept-encoding": "gzip",
          "authorization": "Bearer test-openai-key",
          "content-length": "138",
          "content-type": "application/json",
          "user-agent": "OpenAI/Go 1.12.0",
          "x-stainless-arch": "arm64",
          "x-stainless-lang": "go",
          "x-stainless-os": "MacOS",
          "x-stainless-package-version": "1.12.0",
          "x-stainless-retry-count": "0",
          "x-stainless-runtime": "go",
          "x-stainless-runtime-version": "go1.26.6",
          "x-stainless-timeout": "0"
        },
        "method": "POST",
        "path": "/chat/completions",
        "body": {
          "messages": [
            {
              "content": "Be brief.",
              "role": "developer"
            },
            {
              "content": "Hello",
              "role": "user"
            }
          ],
          "model": "gpt-test",
          "max_completion_tokens": 256
        }
      },
      "response": {
        "body": "{}",
        "status": 200,
        "delayMs": 3000
      }
    }
  ],
  "outcome": {
    "error": {
      "kind": "cancelled",
      "message": "openai generation failed: service unavailable: context deadline exceeded",
      "sentinels": [
        "ErrOpenAIGenerationFailed",
        "ErrServiceUnavailable",
        "context.DeadlineExceeded"
      ],
      "status": 0
    }
  }
}
