        },
        {
          "toolCall": {
            "arguments": "{}",
            "id": "call_2",
            "name": "ping"
          },
          "type": "tool_call"
        }
      ],
      "modelID": "gpt-test",
      "stopReason": "tool_use",
      "usage": {
        "InputTokens": 100,
        "OutputTokens": 20,
        "TotalTokens": 120,
        "ThinkingTokens": 0
      }
    }
  }
}
