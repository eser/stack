{
  "provider": "vertexai",
  "scenario": "auth_service_account_stream",
  "exchanges": [
    {
      "request": {
        "headers": {
          "accept-encoding": "gzip",
          "content-length": "717",
          "content-type": "application/x-www-form-urlencoded",
          "user-agent": "Go-http-client/1.1"
        },
        "form": {
          "grant_type": [
            "urn:ietf:params:oauth:grant-type:jwt-bearer"
          ]
        },
        "method": "POST",
        "path": "/token",
        "assertion": {
          "claims": {
            "aud": "{{server}}/token",
            "iss": "aifx@fixture-project.iam.gserviceaccount.com",
            "scope": "https://www.googleapis.com/auth/cloud-platform"
          },
          "header": {
            "alg": "RS256",
            "kid": "key-1",
            "typ": "JWT"
          },
          "lifetimeSeconds": 3600
        }
      },
      "response": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"access_token\":\"ya29.fixture-token\",\"expires_in\":3599,\"token_type\":\"Bearer\"}",
        "status": 200
      }
    },
    {
      "request": {
        "query": {
          "alt": [
            "sse"
          ]
        },
        "headers": {
          "accept-encoding": "gzip",
          "authorization": "Bearer ya29.fixture-token",
          "content-length": "168",
          "content-type": "application/json",
          "user-agent": "google-genai-sdk/1.71.0 gl-go/go1.26.6",
          "x-goog-api-client": "google-genai-sdk/1.71.0 gl-go/go1.26.6",
          "x-goog-user-project": "quota-project",
          "x-server-timeout": "30"
        },
        "method": "POST",
        "path": "/v1beta1/projects/fixture-project/locations/us-central1/publishers/google/models/gemini-test:streamGenerateContent",
        "body": {
          "contents": [
            {
              "parts": [
                {
                  "text": "Hello"
                }
              ],
              "role": "user"
            }
          ],
          "generationConfig": {
            "maxOutputTokens": 256
          },
          "systemInstruction": {
            "parts": [
              {
                "text": "Be brief."
              }
            ],
            "role": "user"
          }
        }
      },
      "response": {
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "body": "data: {\"candidates\":[{\"content\":{\"role\":\"model\",\"parts\":[{\"text\":\"Hi\"}]},\"finishReason\":\"STOP\"}]}\n\n",
        "status": 200
      }
    }
  ],
  "outcome": {
    "events": [
      {
        "text": "Hi",
        "type": "content_delta"
      },
      {
        "stopReason": "end_turn",
        "type": "message_done"
      }
    ]
  }
}
