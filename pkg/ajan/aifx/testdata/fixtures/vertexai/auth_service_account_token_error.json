{
  "provider": "vertexai",
  "scenario": "auth_service_account_token_error",
  "exchanges": [
    {
      "request": {
        "headers": {
          "accept-encoding": "gzip",
          "content-length": "717",
          "content-type": "application/x-www-form-urlencoded",
          "user-agent": "Go-http-client/1.1"
        },
        "form": {
          "grant_type": [
            "urn:ietf:params:oauth:grant-type:jwt-bearer"
          ]
        },
        "method": "POST",
        "path": "/token",
        "assertion": {
          "claims": {
            "aud": "{{server}}/token",
            "iss": "aifx@fixture-project.iam.gserviceaccount.com",
            "scope": "https://www.googleapis.com/auth/cloud-platform"
          },
          "header": {
            "alg": "RS256",
            "kid": "key-1",
            "typ": "JWT"
          },
          "lifetimeSeconds": 3600
        }
      },
      "response": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"error\":\"invalid_grant\",\"error_description\":\"Invalid JWT Signature.\"}",
        "status": 400
      }
    }
  ],
  "outcome": {
    "error": {
      "kind": "",
      "message": "vertexai generation failed: doRequest: error sending request: Post \"{{server}}/v1beta1/projects/fixture-project/locations/us-central1/publishers/google/models/gemini-test:generateContent\": auth: cannot fetch token: 400\nResponse: {\"error\":\"invalid_grant\",\"error_description\":\"Invalid JWT Signature.\"}",
      "sentinels": [
        "ErrVertexAIGenerationFailed"
      ],
      "status": 0
    }
  }
}
