# The dotenv dialect shared by configfx/envparser and @std/dotenv (TASK-319).
# dialect.json holds the values both parsers must read from this file.
SPACED = spaced value
PLAIN=plain
export EXPORTED=yes
exported_lower=keeps its name
QUOTED_LITERAL="a ${PLAIN} b $PLAIN"
SINGLE='single ${PLAIN} \n'
ESCAPES="tab\there\nnewline \"quoted\" back\\slash"
UNKNOWN_ESCAPE="keep \q"
EXPANDED=${PLAIN}-$PLAIN
FORWARD=${LATER}
LATER=later value
DEFAULTED=${ESER_DIALECT_UNSET_VARIABLE:-fallback}
DEFAULT_UNUSED=${PLAIN:-unused}
BACKSLASH_DOLLAR=\$PLAIN
BACKSLASH_BRACES=\${PLAIN}
EMPTY=
AFTER_EMPTY=next
MULTILINE="first
second"
COMMENTED=value # a comment
