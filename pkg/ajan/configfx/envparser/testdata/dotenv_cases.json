      [
        "A",
        "x}-${ESER_DOTENV_FIXTURE_UNSET_G"
      ]
    ]
  },
  {
    "name": "an empty braced default is part of the name",
    "text": "A=[${ESER_DOTENV_FIXTURE_UNSET_H:-}]",
    "entries": [
      [
        "A",
        "[]"
      ]
    ]
  },
  {
    "name": "empty braces stay as written",
    "text": "A=${}",
    "entries": [
      [
        "A",
        "${}"
      ]
    ]
  },
  {
    "name": "a dollar without a name stays",
    "text": "A=$ and $",
    "entries": [
      [
        "A",
        "$ and $"
      ]
    ]
  },
