[
  {
    "name": "plain keys",
    "text": "A=1\nB=two",
    "entries": [
      [
        "A",
        "1"
      ],
      [
        "B",
        "two"
      ]
    ]
  },
  {
    "name": "spaces around the equals sign",
    "text": "A = spaced value",
    "entries": [
      [
        "A",
        "spaced value"
      ]
    ]
  },
  {
    "name": "the export prefix",
    "text": "export A=yes",
