      "jitter": false,
      "maxAttempts": 4
    },
    "steps": [
      {
        "network": true
      },
      {
        "network": true
      },
      {
        "network": true
      },
      {
        "status": 200
      }
    ],
    "want": {
      "fetches": 4,
      "delays": [
        1000,
        500,
        250
      ],
      "retries": 3,
      "status": 200
    }
  },
  {
    "name": "a stream body is sent once",
    "streamBody": true,
    "steps": [
      {
        "status": 503
      }
    ],
    "want": {
      "fetches": 1,
      "delays": [],
      "error": "HttpResponseError",
      "message": "HTTP 503",
      "status": 503
    }
  },
  {
    "name": "a stream body with retry false is sent once",
    "streamBody": true,
    "client": false,
    "steps": [
      {
        "network": true
      }
    ],
    "want": {
      "fetches": 1,
      "delays": [],
      "error": "HttpNetworkError",
      "message": "fetch failed"
    }
  },
  {
    "name": "a 2xx answers on the first attempt",
    "steps": [
      {
        "status": 201
      }
    ],
    "want": {
      "fetches": 1,
      "delays": [],
      "retries": 0,
      "status": 201
    }
  },
  {
    "name": "a 3xx is an error and is not retried",
    "steps": [
      {
        "status": 304
      }
    ],
    "want": {
      "fetches": 1,
      "delays": [],
      "error": "HttpResponseError",
      "message": "HTTP 304",
      "status": 304
    }
  },
  {
    "name": "mixed failures share one attempt count",
    "client": {
      "jitter": false,
      "maxAttempts": 4,
      "initialDelay": 100
    },
    "steps": [
      {
        "network": true
      },
      {
        "status": 429,
        "retryAfterMs": 1500
      },
      {
        "status": 500
      },
      {
        "status": 200
      }
    ],
    "want": {
      "fetches": 4,
      "delays": [
        100,
        1500,
        400
