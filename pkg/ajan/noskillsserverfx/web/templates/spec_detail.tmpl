{{- /* GET /spec/{name}: the spec with its tasks, open questions and the
actions of its phase. Every data-action is one the action route handles. */ -}}
{{define "body"}}
  <main class="spec-detail" id="main">
    <div class="spec-header">
      <a href="/" class="back-link">&larr; All Specs</a>
      <h1>{{.Name}} {{template "phase_badge" .Badge}}</h1>
      <p class="spec-description">{{.Description}}</p>
      <div class="roadmap">{{.Roadmap}}</div>
      {{- if .Actions}}
      <div class="cta-bar">
        {{- range .Actions}}
        <button class="cta-btn" data-spec="{{$.Slug}}" data-action="{{.Action}}">{{.Label}}</button>
        {{- end}}
      </div>
      {{- end}}
    </div>
    {{- if .Tasks}}
    <div class="tasks-section">
      <h3>Tasks ({{.TasksDone}}/{{len .Tasks}})</h3>
      <ul class="task-list">
        {{- range .Tasks}}
        <li class="{{if .Done}}done{{end}}">
          <input type="checkbox" {{if .Done}}checked {{end}}disabled aria-label="{{.ID}} done" />
          <span>{{.ID}}: {{.Description}}</span>
          {{- if .Files}}
          <span class="file-hints">{{range $i, $file := .Files}}{{if $i}}, {{end}}<code>{{$file}}</code>{{end}}</span>
          {{- end}}
        </li>
        {{- end}}
      </ul>
    </div>
    {{- end}}
    {{- if .Questions}}
    <div class="questions-section">
      <h3>Open Questions</h3>
      {{- range .Questions}}
      <div class="question-item">
        <strong>{{.User}}</strong>: {{.Text}}
        <button class="cta-btn" data-spec="{{$.Slug}}" data-action="reply" data-question-id="{{.ID}}">Reply</button>
      </div>
      {{- end}}
    </div>
    {{- end}}
    {{- if .Content}}
    <div class="spec-content"><pre>{{.Content}}</pre></div>
    {{- end}}
    {{- if .Contributors}}
    <div class="contributors">Contributors: {{range $i, $name := .Contributors}}{{if $i}}, {{end}}{{$name}}{{end}}</div>
    {{- end}}
  </main>
{{end}}
